---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import { SECTIONS, excerpt, formatDate, getPosts, readingTime, withBase, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, section, event, lang } = post.data;
const description = post.data.description ?? excerpt(post.body);
const minutes = readingTime(post.body);
---

<Base title={title} description={description} lang={lang} type="article" published={date}>
  <div class="wrap-wide post-wrap">
    <header class="post-head">
      <p class="crumb">
        <a href={withBase(`/#${section}`)}>← {SECTIONS[section].label}</a>
      </p>
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={formatDate(date, 'iso')}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min de lecture</span>
        {event && (
          <>
            <span aria-hidden="true">·</span>
            <span class="tag">{event}</span>
          </>
        )}
      </p>
    </header>

    <article class="prose" lang={lang}>
      <Content />
    </article>

    <aside class="post-aside">
      <Toc headings={headings} />
    </aside>
  </div>
</Base>

<script>
  import '../../scripts/post';
</script>
